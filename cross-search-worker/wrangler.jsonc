{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tcg-cross-search",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-07",
  "cache": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
